<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!--
      Without this, IIS sends no Cache-Control/Expires header on static files
      (only Last-Modified/ETag), so browsers fall back to heuristic caching and
      can hold onto an old mobile.min.js/scripts.min.js for weeks. That lets a
      stale cached script run against freshly-served HTML whose DOM has since
      changed, throwing null-reference errors mid-render (e.g. the config title
      never gets applied, leaving the default placeholder visible).
      Capping every static asset at a short max-age bounds that mismatch window
      to minutes instead of weeks, regardless of file type.
    -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:10:00" />
    </staticContent>
  </system.webServer>
</configuration>
